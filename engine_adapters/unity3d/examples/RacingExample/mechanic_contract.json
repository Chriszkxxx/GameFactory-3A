{
  "schema_version": "gamefactory3a.mechanic_contract.v1",
  "contract_version": 1,
  "gameplay_module": "RacingExample",
  "mechanic_id": "racing",
  "state": {
    "vehicle_speed": "RacingGameMode.VehicleSpeed",
    "current_lap": "RacingGameMode.CurrentLap",
    "total_laps": "RacingGameMode.TotalLaps",
    "checkpoints_passed": "RacingGameMode.CheckpointsPassed",
    "total_checkpoints": "RacingGameMode.TotalCheckpoints",
    "race_active": "RacingGameMode.IsRaceActive",
    "race_finished": "RacingGameMode.IsFinished"
  },
  "events": {
    "on_race_started": "RacingGameMode.OnRaceStarted",
    "on_checkpoint_passed": "RacingGameMode.OnCheckpointPassed",
    "on_lap_completed": "RacingGameMode.OnLapCompleted",
    "on_race_finished": "RacingGameMode.OnRaceFinished",
    "on_state_changed": "RacingGameMode.OnStateChanged"
  },
  "commands": {
    "drive": "RacingGameMode.Drive(float,float,bool,float)",
    "reset_game": "RacingGameMode.Restart()",
    "apply_input": "RacingVehicleController.ApplyInput(A3GameRuntimeInputState)"
  },
  "public_api_paths": [
    "Scripts/RacingGameMode.cs",
    "Scripts/RacingVehicleController.cs",
    "Scripts/RacingLapCounter.cs"
  ],
  "behavioral_invariants": [
    "Only the next checkpoint in sequence advances progress",
    "Passing every checkpoint resets progress and increments the lap",
    "Completing the target lap finishes the race",
    "Setup is idempotent and creates one vehicle",
    "Runtime movement input controls throttle and steering",
    "Runtime run input applies the boost acceleration modifier",
    "Restart restores the vehicle, lap counter, and race state"
  ],
  "dependencies": {
    "assemblies": [
      "A3GameRuntime"
    ]
  }
}
