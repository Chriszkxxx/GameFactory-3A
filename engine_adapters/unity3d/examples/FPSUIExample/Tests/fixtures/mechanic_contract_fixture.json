{
  "schema_version": "aaagameforge.mechanic_contract_fixture.v1",
  "mechanic_contract": {
    "schema_version": "aaagameforge.mechanic_contract.v1",
    "contract_version": 1,
    "gameplay_module": "FPSExample"
  },
  "scenarios": [
    {
      "name": "initial_hud",
      "state": {
        "player_health": 100,
        "player_ammo": 30,
        "enemies_killed": 0,
        "game_state": "Playing"
      },
      "expected": {
        "health_label": "HP: 100/100",
        "ammo_label": "30 / 30",
        "kill_label": "Kills: 0 / 3",
        "timer_label": "00:60"
      }
    },
    {
      "name": "reload_feedback",
      "state": {
        "player_health": 100,
        "player_ammo": 29,
        "enemies_killed": 0,
        "game_state": "Playing"
      },
      "events": [
        "on_weapon_fired",
        "on_weapon_reload"
      ],
      "expected": {
        "ammo_label": "RELOADING..."
      }
    },
    {
      "name": "win_overlay",
      "state": {
        "player_health": 50,
        "player_ammo": 8,
        "enemies_killed": 3,
        "game_state": "Won"
      },
      "events": [
        "on_game_win"
      ],
      "expected": {
        "title": "ARENA CLEARED!"
      }
    },
    {
      "name": "lose_overlay",
      "state": {
        "player_health": 0,
        "player_ammo": 12,
        "enemies_killed": 2,
        "game_state": "Lost"
      },
      "events": [
        "on_player_damaged",
        "on_game_lose"
      ],
      "expected": {
        "title": "YOU DIED"
      }
    }
  ]
}
