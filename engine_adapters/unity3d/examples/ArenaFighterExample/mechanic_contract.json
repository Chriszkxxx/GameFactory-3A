{
  "schema_version": "gamefactory3a.mechanic_contract.v1",
  "contract_version": 1,
  "gameplay_module": "ArenaFighterExample",
  "mechanic_id": "arena_fighter",
  "state": {
    "player_health": "ArenaFighterGameMode.PlayerHealth",
    "opponent_health": "ArenaFighterGameMode.OpponentHealth",
    "round_active": "ArenaFighterGameMode.IsRoundActive",
    "player_won": "ArenaFighterGameMode.PlayerWon"
  },
  "events": {
    "on_round_started": "ArenaFighterGameMode.OnRoundStarted",
    "on_player_attack": "ArenaFighterGameMode.OnPlayerAttack(bool)",
    "on_player_won": "ArenaFighterGameMode.OnPlayerWon",
    "on_player_lost": "ArenaFighterGameMode.OnPlayerLost",
    "on_state_changed": "ArenaFighterGameMode.OnStateChanged"
  },
  "commands": {
    "player_attack": "ArenaFighterGameMode.PlayerAttack()",
    "reset_game": "ArenaFighterGameMode.RestartRound()",
    "apply_input": "ArenaFighterController.ApplyInput(A3GameRuntimeInputState)"
  },
  "public_api_paths": [
    "Scripts/ArenaFighterGameMode.cs",
    "Scripts/ArenaFighterController.cs"
  ],
  "behavioral_invariants": [
    "A successful in-range attack reduces the target by AttackDamage",
    "Health at zero marks a fighter dead and prevents further actions",
    "An out-of-range attack does not damage the target",
    "Setup is idempotent and creates one player and one opponent",
    "Runtime movement input moves the player-controlled fighter",
    "Runtime primary-action input requests the player attack command",
    "Restart restores both fighters and their spawn transforms"
  ],
  "dependencies": {
    "assemblies": [
      "A3GameRuntime"
    ]
  }
}
