; Godot 4 project: Arena Duel
config_version=5

[application]
config/name="Arena Duel"
run/main_scene="res://main.tscn"

[autoload]
ArenaDuelRuntime="res://mechanic/runtime_adapter.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[input]
confirm_restart={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194309)]}
pause_cancel={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.02, 0.055, 1)
